# config/speak - spoken replies for this home (bin/fm-speak.sh).
# Copy this into a local, gitignored config/speak to have the first mate speak
# its replies out of this Mac's speaker. Without this file it stays silent.
# `key = value` lines; unknown keys are refused. See docs/configuration.md
# "Desk voice-out" for what it needs: the Starship Voice project cloned under
# projects/, and either DEEPGRAM_API_KEY in .env or a macOS voice below.
enabled = true

# Optional macOS `say` voice; naming one speaks through `say` instead of
# Deepgram. Leave it commented out to use Deepgram when the key is set.
# voice = Ava
