#!/usr/bin/env bash
# Sentinel hook (bin/fm-addon.sh): an armed glasses shift is work the host
# sentinel watches over even with no crew task in flight, because a shift's
# questions arrive as mailbox events rather than as tasks. bin/fm-shift.sh
# writes and removes the shift record, and fm_sup_shift_armed in
# bin/fm-supervision-lib.sh is the single definition of "armed".
set -u
root=${FM_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}
# shellcheck source=bin/fm-supervision-lib.sh
. "$root/bin/fm-supervision-lib.sh"
if fm_sup_shift_armed "${FM_STATE_OVERRIDE:-$FM_HOME/state}"; then
  printf 'glasses shift armed\n'
fi
